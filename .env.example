# ============================================================================
# ENVIRONMENT VARIABLES - Example Configuration
# ============================================================================
#
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to git! (.env is in .gitignore)
#
# ============================================================================
# EMBEDDINGS CONFIGURATION (NEW - Optional)
# ============================================================================
# Get free Groq API key at: https://console.groq.com/
# Leave blank to use local Sentence Transformers (free, offline-capable)
#
# With key: Hybrid approach tries Groq first (50ms), falls back to local (100ms)
# Without key: Uses local Sentence Transformers only (100ms, completely offline)
GROQ_API_KEY=gsk_your_api_key_here

# Optional: Configure embeddings behavior globally
# USE_EMBEDDINGS=true               # Enable/disable embeddings globally
# EMBEDDINGS_BLEND_RATIO=0.7        # Semantic weight in blended matching (0.0-1.0)
# EMBEDDINGS_MODEL=hybrid            # hybrid|groq|sentence-transformers

# ============================================================================
# SMTP/Email Configuration (For sending recruitment emails)
# ============================================================================
# Gmail setup:
#   1. Enable 2-Factor Authentication in Google Account
#   2. Generate App Password: https://myaccount.google.com/apppasswords
#   3. Use the 16-character app password below (not your main password)
#
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_16_char_app_password

# Optional: SendGrid alternative
# SENDGRID_API_KEY=sg_your_api_key_here
# SENDGRID_SENDER_EMAIL=noreply@yourdomain.com

# Pipeline notification (receives summary email when pipeline completes)
PIPELINE_NOTIFICATION_EMAIL=admin@company.com
DEFAULT_FALLBACK_RECIPIENT=fallback@company.com

# Email display settings
MAIL_SENDER_NAME=Recruitment Bot
MAIL_SENDER_TITLE=Automated Hiring System

# ============================================================================
# Email Extraction (IMAP) Configuration
# ============================================================================
# For extracting candidates from emails (--extract-from-emails flag)
#
# Gmail setup:
#   1. Enable "Less secure app access": https://myaccount.google.com/lesssecureapps
#   2. Use your Gmail password (or app password)
#   3. Set IMAP_SERVER=imap.gmail.com
#
# Corporate email (example: Emotifzone):
#   IMAP_SERVER=mail.emotifzone.com
#   IMAP_EMAIL=careers@emotifzone.com
#   IMAP_PASSWORD=your_email_password
#
IMAP_SERVER=mail.emotifzone.com
IMAP_EMAIL=careers@emotifzone.com
IMAP_PASSWORD=your_email_password

# Alternative: Gmail IMAP
# IMAP_SERVER=imap.gmail.com
# IMAP_EMAIL=your_email@gmail.com
# IMAP_PASSWORD=your_gmail_app_password

# ============================================================================
# OPTIONAL: Global Pipeline Settings
# ============================================================================
# Override command-line defaults globally

# Enable embeddings by default (can override with --use-embeddings flag)
# USE_EMBEDDINGS=true

# Default blend ratio for semantic matching (0.0-1.0)
# EMBEDDINGS_BLEND_RATIO=0.7

# Embedding model to use (hybrid|groq|sentence-transformers)
# EMBEDDINGS_MODEL=hybrid

# ============================================================================
# NOTES
# ============================================================================
#
# 1. NEVER commit .env to git
#    - .env is in .gitignore
#    - Contains passwords and API keys
#    - Only .env.example should be in git
#
# 2. API Keys and Passwords:
#    - Keep them secret and secure
#    - Use app passwords, not main passwords
#    - Regenerate if compromised
#    - Never share via email or Slack
#
# 3. File Format:
#    - KEY=VALUE (no quotes needed unless value has spaces)
#    - Lines starting with # are comments
#    - Empty lines are ignored
#    - Spaces around = are OK
#
# 4. Getting API Keys:
#    - Groq: https://console.groq.com/
#    - SendGrid: https://sendgrid.com/
#    - Gmail App Password: https://myaccount.google.com/apppasswords
#
# 5. For more details, see:
#    - GROQ_SETUP.md (Groq configuration)
#    - QUICK_START.md (Quick setup)
#    - COMMAND_REFERENCE.md (All command options)
#
# ============================================================================
# QUICK SETUP
# ============================================================================
#
# Minimal setup (token-based matching only):
#   1. Copy this file: cp .env.example .env
#   2. Add SMTP credentials (optional, for emails)
#   3. Run: python run_integrated_pipeline.py
#
# With embeddings (recommended):
#   1. Copy this file: cp .env.example .env
#   2. Get Groq key: https://console.groq.com/
#   3. Set GROQ_API_KEY=gsk_your_key
#   4. Run: python run_integrated_pipeline.py --use-embeddings
#
# With email extraction:
#   1. Copy this file: cp .env.example .env
#   2. Set IMAP credentials (Gmail or corporate email)
#   3. Run: python run_integrated_pipeline.py --extract-from-emails
#
# ============================================================================
